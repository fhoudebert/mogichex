# Le dist jocly est volumineux et construit avec l'application : il ne fait
# pas partie du depot (voir README, « Mise en route »).
/dist
/node_modules
/signals
# Parties deposees par match.php quand le relai tourne depuis la racine du
# depot (serveur PHP local). Meme raison que /signals.
/matches
/bak
/deploy/signalconf.php
.DS_Store
package-lock.json
# --- Android ---------------------------------------------------------------
# Le projet natif Capacitor (android/) et capacitor.config.json SONT versionnes :
# icone, manifeste, version et signature (android/app/mogichex.gradle) doivent
# etre identiques sur le poste et dans le CI. Seul ce qui est genere ou propre
# a une machine est ignore ci-dessous. android/.gitignore (gabarit Capacitor)
# dit la meme chose ; ces regles-ci restent pour ne pas dependre de lui.
#
# Contenu web produit par tools/build-android.mjs (webDir), puis recopie par
# « npx cap sync » dans le projet natif : 50 a 90 Mo, regenere a chaque build.
/www
/android/www
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
/android/capacitor-cordova-android-plugins
# Sorties et caches de Gradle / Android Studio.
/android/.gradle
/android/build/
/android/app/build/
/android/.idea
*.apk
*.aab
# Chemin du SDK de CETTE machine (ecrit par Android Studio).
/android/local.properties
/problems

# --- Signature : jamais dans le depot ---------------------------------------
# android/app/mogichex.gradle lit la signature dans l'environnement (CI) ou,
# sur le poste, dans android/keystore.properties : ce fichier porte les mots
# de passe en clair, il ne doit JAMAIS etre versionne. Le gabarit Capacitor
# laisse *.keystore en commentaire : c'est cette regle-ci qui protege un
# keystore range sous android/.
*.keystore
*.jks
keystore.properties
*.patch
