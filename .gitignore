# Le dist jocly est volumineux et construit avec l'application : il ne fait
# pas partie du depot (voir README, « Mise en route »).
/dist
/node_modules
/signals
# Parties deposees par match.php quand le relai tourne depuis la racine du
# depot (serveur PHP local). Meme raison que /signals.
/matches
/bak
/deploy/signalconf.php
.DS_Store
package-lock.json
# Le contenu web Android est genere par tools/build-android.mjs, et le projet
# natif par « npx cap add android » : ni l'un ni l'autre n'a sa place ici.
# android/README.md, lui, est versionne.
# Le contenu web genere par tools/build-android.mjs (webDir de Capacitor).
/www

android/app/build
android/build
android/gradle*
android/.gitignore

/android/build/
/problems

# Signature : jamais dans le depot.
*.keystore
*.patch
keystore.properties
/android/mogichex.keystore
/android/keystore.properties
