{
  "name": "mogichex",
  "version": "1.01.0",
  "description": "Board games (Jocly) playable with a thumb — installable web app.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fhoudebert/mogichex"
  },
  "scripts": {
    "test": "node --test \"tests/*.mjs\"",
    "test:php": "php tests/test-signal.php && php tests/test-match.php && php tests/test-fileio.php",
    "catalog": "node tools/build-catalog.mjs --jocly ../jocly2",
    "scan": "node tools/scan-geometry.mjs --jocly ../jocly2",
    "stamp": "node tools/stamp-sw.mjs",
    "build": "npm run catalog && npm run stamp && npm test",
    "serve": "node tools/serve.mjs",
    "android:multiplayer-2d": "node tools/build-android.mjs --jocly ../jocly2 --no-3d",
    "android:multiplayer-3d": "node tools/build-android.mjs --jocly ../jocly2 --3d",
    "android:offline-2d": "node tools/build-android.mjs --jocly ../jocly2 --no-3d --offline"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2"
  }
}
